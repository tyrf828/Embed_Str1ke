//----------------------------------------------------------------------------
//!	@file	ps_gaussian.fx
//!	@brief	ガウシアンブラー
//----------------------------------------------------------------------------
#include "dxlib_ps.h"

cbuffer FilterInfo : register(b13)
{
    float2 pixel_offset_; // 隣接ピクセルへのUV移動量
}

    
// automatically generated by GenerateGaussFunctionCode in GaussianBlur.h                                                                                            
float4 GaussianBlur(Texture2D texture2d, SamplerState samplerState, float2 centerUV, float2 pixel_offset)
{
    // Kernel 7 x 7
    const int step_count = 2;
    
    const float g_weights[step_count] = { 0.44908f, 0.05092f };
    const float g_offsets[step_count] = { 0.53805, 2.06278 };
    
    float4 color = float4(0, 0, 0, 0);

    [unroll]
    for (int i = 0; i < step_count; i++)
    {
        float2 offset = g_offsets[i] * pixel_offset;
        float4 c = texture2d.Sample(samplerState, centerUV + offset) +
                   texture2d.Sample(samplerState, centerUV - offset);
        color += g_weights[i] * c;
    }

    return color;
}

//----------------------------------------------------------------------------
// メイン関数
//----------------------------------------------------------------------------
PS_OUTPUT main(PS_INPUT input)
{
    // https://www.intel.com/content/www/us/en/developer/articles/technical/an-investigation-of-fast-real-time-gpu-based-image-blur-algorithms.html
    PS_OUTPUT output;
    output.color0_ = GaussianBlur(DiffuseTexture, DiffuseSampler, input.uv0_, pixel_offset_);
	// 出力パラメータを返す
    return output;
}
